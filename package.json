{
  "name": "@lore-hex/trusted-router",
  "version": "0.9.0",
  "description": "JavaScript SDK and CLI for TrustedRouter — typed errors, retries, failover, and attestation verification.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "trustedrouter": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./attestation": {
      "types": "./dist/attestation.d.ts",
      "import": "./dist/attestation.js"
    },
    "./oauth": {
      "types": "./dist/oauth.d.ts",
      "import": "./dist/oauth.js"
    },
    "./receipts": {
      "types": "./dist/receipts.d.ts",
      "import": "./dist/receipts.js"
    },
    "./session": {
      "types": "./dist/session.d.ts",
      "import": "./dist/session.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "license": "Apache-2.0",
  "author": "Lore Hex",
  "homepage": "https://trustedrouter.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lore-Hex/trusted-router-js.git"
  },
  "bugs": {
    "url": "https://github.com/Lore-Hex/trusted-router-js/issues"
  },
  "scripts": {
    "check": "npm run typecheck && node --test test/declaration-sync.test.js",
    "test": "node --test",
    "typecheck": "tsc -p tsconfig.json",
    "lint:package": "publint && attw --pack . --profile esm-only",
    "build": "node scripts/build.mjs",
    "pretest": "npm run build",
    "lint": "eslint src test",
    "test:mutations": "node scripts/mutation-check.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "trustedrouter",
    "openai",
    "anthropic",
    "llm",
    "router",
    "cli",
    "attested",
    "confidential-computing"
  ],
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^20.17.9",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.4",
    "publint": "^0.3.24",
    "typescript": "^5.9.3"
  },
  "sideEffects": [
    "./dist/cli.js",
    "./src/cli.ts"
  ]
}
